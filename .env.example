# Public, browser-visible configuration only. Never put secrets here:
# every VITE_* variable is embedded in the client bundle.

# Leave unset: the admin calls /api on its own origin, which the dev server proxies
# (vite.config.ts) and Vercel rewrites (vercel.json) to the backend. No CORS involved.
# VITE_API_BASE_URL=

# The dev server proxies /api to the deployed backend (https://vridhio-backend.vercel.app).
# For a local backend, set it in the shell (not read from this file):
#   API_PROXY_TARGET=http://localhost:8000 npm run dev
